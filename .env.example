# ─────────────────────────────────────────────────────────────────────────────
# TechWithKesava — Environment Variables
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# Contact Form Integrations
# Add your Discord webhook URL here to forward contact form submissions directly to a Discord channel
CONTACT_DISCORD_WEBHOOK_URL=

# OR: Configure email forwarding using the Resend service
# RESEND_API_KEY=
# CONTACT_TO_EMAIL=techwithkesava@gmail.com

# ─────────────────────────────────────────────────────────────────────────────
# Supabase
# Create a project at https://supabase.com/dashboard, then grab these from
# Project Settings → API.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose this to the browser. Required for admin CRUD.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Admin CMS
# Temporary demo authentication. Replace with Supabase Auth later.
# If unset, defaults to admin / admin123.
# ─────────────────────────────────────────────────────────────────────────────
# Secret used to sign admin session cookies. Use a long random string in production.
ADMIN_SESSION_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
